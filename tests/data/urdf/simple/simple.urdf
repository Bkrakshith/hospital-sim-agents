<?xml version="1.0"?>
<robot name="simple_bot">
  <link name="base_link"><inertial><mass value="10"/><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><mesh filename="meshes/base.stl"/></geometry></visual></link>
  <link name="torso"><inertial><mass value="5"/><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="arm"><inertial><mass value="1.5"/><inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <link name="head"/>
  <joint name="waist" type="revolute"><parent link="base_link"/><child link="torso"/><origin xyz="0 0 0.5" rpy="0 0 0"/>
    <axis xyz="0 0 1"/><limit lower="-1.5" upper="1.5" effort="50" velocity="2"/></joint>
  <joint name="shoulder" type="revolute"><parent link="torso"/><child link="arm"/><origin xyz="0 0.2 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/><limit lower="-2" upper="2" effort="30" velocity="2"/></joint>
  <joint name="neck" type="fixed"><parent link="torso"/><child link="head"/><origin xyz="0 0 0.6" rpy="0 0 0"/></joint>
</robot>
