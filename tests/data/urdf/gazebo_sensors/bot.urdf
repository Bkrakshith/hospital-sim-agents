<?xml version="1.0"?>
<robot name="sensor_bot">
  <link name="base_link"/>
  <link name="cam_link"/>
  <link name="lidar_link"/>
  <joint name="j_cam" type="fixed"><parent link="base_link"/><child link="cam_link"/><origin xyz="0.1 0 0.8" rpy="0 0 0"/></joint>
  <joint name="j_lidar" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 1.0" rpy="0 0 0"/></joint>
  <gazebo reference="cam_link">
    <sensor type="depth" name="front_depth"><pose>0.02 0 0 0 0.1 0</pose>
      <camera><horizontal_fov>1.5</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.2</near><far>8</far></clip></camera></sensor>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor type="gpu_ray" name="scan"><pose>0 0 0.05 0 0 0</pose>
      <ray><scan><horizontal><samples>720</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
      <range><min>0.1</min><max>25</max></range></ray></sensor>
  </gazebo>
  <gazebo reference="ghost_link"><sensor type="camera" name="orphan"/></gazebo>
</robot>
